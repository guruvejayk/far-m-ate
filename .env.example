# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# DATABASE_URL: PostgreSQL connection string (when using external DB or demo storage)
DATABASE_URL="postgresql://user:password@localhost:5432/farmate"

# AUTH_SECRET: Used for session and token signing
AUTH_SECRET="your-auth-secret-key"

# Additional provider keys (optional; Gemini provides vision/llm/speech)
VISION_API_KEY=""
SPEECH_TO_TEXT_API_KEY=""
TEXT_TO_SPEECH_API_KEY=""
PRODUCT_VERIFICATION_API_KEY=""
MAPS_API_KEY=""

